{
  "meta": {
    "version": "1.1",
    "description": "Kanoniskt repository-layoutkontrakt för first-party Crow-moduler",
    "new_modules_must_live_under": "modules/",
    "root_src_policy": "Backbone src/ får endast innehålla delade plattformskapabiliteter och värdskal; verksamhetsdomäner ägs av first-party-moduler under modules/."
  },
  "modules": [
    {
      "module_id": "crow.vent",
      "repository_root": "modules/crow-vent-module",
      "requires_modules": [],
      "owned_packages": [
        "crow_vent",
        "crow_vent_drawing",
        "crow_riser_model",
        "crow_vent_quote",
        "crow_benchmark_pricing",
        "crow_takeoff_consolidation"
      ],
      "migration_pending_from_root_src": true
    },
    {
      "module_id": "crow.provtryckning",
      "repository_root": "modules/crow-pressure-test-module",
      "requires_modules": ["crow.vent"],
      "owned_packages": ["crow_pressure_test"],
      "migration_pending_from_root_src": true
    },
    {
      "module_id": "crow.ovk",
      "repository_root": "modules/crow-ovk-module",
      "requires_modules": [],
      "owned_packages": [
        "crow_ovk",
        "crow_ovk_field",
        "crow_ovk_workflow",
        "crow_ovk_import",
        "crow_ovk_pricing",
        "crow_ovk_legacy",
        "crow_ovk_reporting",
        "crow_ovk_module"
      ],
      "migration_pending_from_root_src": false
    }
  ],
  "shared_backbone_examples": [
    "crow_module_sdk",
    "crow_module_conformance",
    "crow_workbench",
    "crow_import_framework",
    "crow_dwg_conversion",
    "crow_cad_text",
    "crow_ifc_relations",
    "crow_building_graph",
    "crow_regulations",
    "crow_entitlements"
  ]
}

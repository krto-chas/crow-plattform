# Host exposure. Loopback remains the default.
CROW_PLATFORM_BIND_ADDRESS=127.0.0.1
CROW_PLATFORM_PORT=8080

# Numeric host UID/GID used for writes to the mounted Platform directories.
CROW_PLATFORM_UID=1000
CROW_PLATFORM_GID=1000

# Persistent host directories. Config is deliberately separated from project/runtime data.
CROW_PLATFORM_DATA_DIR=/srv/crow-data/platform
CROW_PLATFORM_CONFIG_DIR=/srv/crow-config/platform
CROW_PLATFORM_BACKUP_DIR=/srv/crow-backups/platform

# Bounded local Docker logging.
CROW_PLATFORM_LOG_MAX_SIZE=10m
CROW_PLATFORM_LOG_MAX_FILES=5

# Debian Compose deployment runs the Platform in session mode.
CROW_AUTH_MODE=session
CROW_SESSION_SECRET=

# false is required for the current plain-HTTP internal deployment.
# Set true when the browser reaches Crow through HTTPS/TLS.
CROW_COOKIE_SECURE=false

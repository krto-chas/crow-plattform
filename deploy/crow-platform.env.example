# Backend diagnostic exposure. Keep loopback-only; browsers should use the HTTPS proxy.
CROW_PLATFORM_BIND_ADDRESS=127.0.0.1
CROW_PLATFORM_PORT=8080

# HTTPS reverse-proxy exposure. Keep loopback-only until LAN/public exposure is intentional.
CROW_PROXY_BIND_ADDRESS=127.0.0.1
CROW_PROXY_HTTP_PORT=80
CROW_PROXY_HTTPS_PORT=443
CROW_PROXY_SITE=crow.localhost

# Numeric host UID/GID used for writes to the mounted Platform directories.
CROW_PLATFORM_UID=1000
CROW_PLATFORM_GID=1000

# Persistent host directories.
CROW_PLATFORM_DATA_DIR=/srv/crow-data/platform
CROW_PLATFORM_CONFIG_DIR=/srv/crow-config/platform
CROW_PLATFORM_BACKUP_DIR=/srv/crow-backups/platform

# Bounded local Docker logging.
CROW_PLATFORM_LOG_MAX_SIZE=10m
CROW_PLATFORM_LOG_MAX_FILES=5
CROW_PROXY_LOG_MAX_SIZE=10m
CROW_PROXY_LOG_MAX_FILES=5

# Debian Compose deployment runs the Platform in session mode behind HTTPS.
CROW_AUTH_MODE=session
CROW_SESSION_SECRET=
CROW_COOKIE_SECURE=true
